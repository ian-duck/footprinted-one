      "seed": 2061895159,
      "version": 4,
      "versionNonce": 1522021431,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788553731509,
      "link": null,
      "locked": false,
      "customData": {
        "generationData": {
          "status": "done",
          "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Footprinted.eu Dashboard</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }\n        \n        .progress-ring {\n            transform: rotate(-90deg);\n        }\n        .progress-ring__circle {\n            transition: stroke-dashoffset 0.35s;\n            transform-origin: 50% 50%;\n        }\n    </style>\n</head>\n<body class=\"min-h-screen p-4 md:p-8\">\n\n    <div class=\"max-w-7xl mx-auto bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden flex flex-col h-[90vh]\">\n        \n        <!-- Header -->\n        <header class=\"border-b border-slate-100 p-4 flex items-center justify-between bg-white\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center text-white\">\n                    <i class=\"fas fa-shoe-prints\"></i>\n                </div>\n                <span class=\"text-xl font-bold text-slate-800 tracking-tight\">Footprinted.eu</span>\n            </div>\n            <div class=\"flex gap-3\">\n                <button class=\"px-6 py-2 rounded-full border border-slate-200 hover:bg-slate-50 transition-colors font-medium text-slate-600\">\n                    Quests\n                </button>\n                <button class=\"px-6 py-2 rounded-full bg-slate-900 text-white hover:bg-slate-800 transition-colors font-medium flex items-center gap-2\">\n                    <i class=\"far fa-user-circle\"></i> Profile\n                </button>\n            </div>\n        </header>\n\n        <!-- Main Content Area -->\n        <main class=\"flex-1 flex flex-col md:flex-row overflow-hidden\">\n            \n            <!-- Sidebar: Quest View -->\n            <aside class=\"w-full md:w-80 border-r border-slate-100 flex flex-col overflow-y-auto p-6 gap-6 bg-slate-50/50\">\n                <div>\n                    <h2 class=\"text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4\">Quest View</h2>\n                    \n                    <!-- Progress Section -->\n                    <div class=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm\">\n                        <div class=\"flex items-center gap-4\">\n                            <!-- Circular Progress -->\n                            <div class=\"relative flex items-center justify-center\">\n                                <svg class=\"progress-ring\" width=\"80\" height=\"80\">\n                                    <circle class=\"text-slate-100\" stroke-width=\"8\" stroke=\"currentColor\" fill=\"transparent\" r=\"32\" cx=\"40\" cy=\"40\"/>\n                                    <circle class=\"text-emerald-500 progress-ring__circle\" stroke-width=\"8\" stroke-dasharray=\"201.06\" stroke-dashoffset=\"60.31\" stroke-linecap=\"round\" stroke=\"currentColor\" fill=\"transparent\" r=\"32\" cx=\"40\" cy=\"40\"/>\n                                </svg>\n                                <span class=\"absolute text-sm font-bold text-slate-700\">70%</span>\n                            </div>\n                            <!-- Region Buttons -->\n                            <div class=\"flex flex-col gap-2 flex-1\">\n                                <button class=\"w-full text-xs font-semibold py-2 px-3 rounded-lg border border-slate-200 hover:bg-slate-50 transition-all\">Region</button>\n                                <button class=\"w-full text-xs font-semibold py-2 px-3 rounded-lg border border-slate-200 hover:bg-slate-50 transition-all\">Subregion</button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Recently Footprinted -->\n                <section>\n                    <h3 class=\"text-sm font-semibold text-slate-500 mb-3 flex items-center gap-2\">\n                        <i class=\"fas fa-history text-xs\"></i> Recently footprinted\n                    </h3>\n                    <div class=\"bg-white rounded-2xl border border-slate-200 p-4 min-h-[100px] shadow-sm\">\n                        <div class=\"flex items-center gap-3 mb-3\">\n                            <div class=\"w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center\">\n                                <i class=\"fas fa-check text-emerald-600 text-xs\"></i>\n                            </div>\n                            <div>\n                                <p class=\"text-sm font-medium text-slate-700\">Central Park</p>\n                                <p class=\"text-[10px] text-slate-400\">2 hours ago</p>\n                            </div>\n                        </div>\n                        <div class=\"w-full h-1 bg-slate-100 rounded-full overflow-hidden\">\n                            <div class=\"w-full h-full bg-emerald-400\"></div>\n                        </div>\n                    </div>\n                </section>\n\n                <!-- Not Footprinted Yet -->\n                <section class=\"flex-1\">\n                    <h3 class=\"text-sm font-semibold text-slate-500 mb-3 flex items-center gap-2\">\n                        <i class=\"far fa-map text-xs\"></i> Not footprinted yet\n                    </h3>\n                    <div class=\"bg-white rounded-2xl border border-slate-200 shadow-sm p-4 h-full\">\n                        <ul class=\"space-y-4\">\n                            <li class=\"flex items-center justify-between text-sm text-slate-600 p-2 hover:bg-slate-50 rounded-lg cursor-pointer\">\n                                <span>Riverside District</span>\n                                <i class=\"fas fa-chevron-right text-[10px] text-slate-300\"></i>\n                            </li>\n                            <li class=\"flex items-center justify-between text-sm text-slate-600 p-2 hover:bg-slate-50 rounded-lg cursor-pointer\">\n                                <span>Old Town Square</span>\n                                <i class=\"fas fa-chevron-right text-[10px] text-slate-300\"></i>\n                            </li>\n                            <li class=\"flex items-center justify-between text-sm text-slate-600 p-2 hover:bg-slate-50 rounded-lg cursor-pointer\">\n                                <span>Hillside Park</span>\n                                <i class=\"fas fa-chevron-right text-[10px] text-slate-300\"></i>\n                            </li>\n                            <li class=\"flex items-center justify-between text-sm text-slate-600 p-2 hover:bg-slate-50 rounded-lg cursor-pointer\">\n                                <span>Docklands</span>\n                                <i class=\"fas fa-chevron-right text-[10px] text-slate-300\"></i>\n                            </li>\n                        </ul>\n                    </div>\n                </section>\n            </aside>\n\n            <!-- Map View Area -->\n            <section class=\"flex-1 relative bg-slate-100 group\">\n                <!-- Map Placeholder Image -->\n                <img src=\"https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&q=80&w=2000\" \n                     alt=\"Map view\" \n                     class=\"w-full h-full object-cover\">\n                \n                <!-- Map Overlay Text -->\n                <div class=\"absolute top-6 left-6 bg-white/90 backdrop-blur px-4 py-2 rounded-xl shadow-lg border border-white\">\n                    <h2 class=\"text-sm font-bold text-slate-800\">Map View</h2>\n                    <p class=\"text-[10px] text-slate-500\">Interactive Region Exploration</p>\n                </div>\n\n                <!-- Map UI Controls -->\n                <div class=\"absolute bottom-6 right-6 flex flex-col gap-2\">\n                    <button class=\"w-10 h-10 bg-white rounded-xl shadow-lg flex items-center justify-center text-slate-600 hover:bg-slate-50 transition-colors\">\n                        <i class=\"fas fa-plus text-sm\"></i>\n                    </button>\n                    <button class=\"w-10 h-10 bg-white rounded-xl shadow-lg flex items-center justify-center text-slate-600 hover:bg-slate-50 transition-colors\">\n                        <i class=\"fas fa-minus text-sm\"></i>\n                    </button>\n                    <button class=\"w-10 h-10 bg-emerald-500 rounded-xl shadow-lg flex items-center justify-center text-white hover:bg-emerald-600 transition-colors\">\n                        <i class=\"fas fa-location-arrow text-sm\"></i>\n                    </button>\n                </div>\n\n                <!-- Map Marker Example -->\n                <div class=\"absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 group-hover:scale-110 transition-transform cursor-pointer\">\n                    <div class=\"relative\">\n                        <div class=\"absolute -top-12 -left-1/2 bg-white px-3 py-1 rounded-lg shadow-xl text-[10px] font-bold whitespace-nowrap border border-slate-100\">\n                            Current Quest Area\n                        </div>\n                        <div class=\"w-12 h-12 bg-emerald-500/20 rounded-full flex items-center justify-center animate-pulse\">\n                            <div class=\"w-4 h-4 bg-emerald-500 rounded-full border-2 border-white\"></div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n        </main>\n    </div>\n\n</body>\n</html>"
        }
      }
    }
  ],
  "appState": {
    "gridSize": 20,
    "gridStep": 5,
    "gridModeEnabled": false,
    "viewBackgroundColor": "#ffffff",
    "lockedMultiSelections": {}
  },
  "files": {}
}